backend/node_modules/

.env
backend/.env

# Claude Code 개인 설정. 허용 명령 목록에 접속 문자열이 그대로 들어가는 일이 있어
# (실제로 운영 MYSQL_URL 이 들어 있었다) 절대 커밋하지 않는다.
# .claude/launch.json 은 팀이 공유하는 실행 설정이라 커밋한다.
.claude/settings.local.json

data/db.json
backend/data/db.json

# DART 고유번호 색인. 커밋하지 않는다 — 공시대상 전체 11만여 건이라 6MB 이고,
# 다시 받을 때마다 그 크기가 히스토리에 통째로 쌓인다. 우리가 만든 자료가 아니라
# DART 가 매일 주는 원본이라 받아 오면 그만이다.
#   배포: 빌드 단계에서 자동 (루트 package.json 의 build)
#   로컬: npm run build   (키가 없으면 건너뛴다 — 기업분석만 빈다)
backend/data/dart-corps.json
# 공공기관 채용공고(잡알리오) — 하루 한 번 새로 받는 원본이라 커밋하지 않는다.
# 16-9 의 교훈: 넣기 전에 '비싸게 만든 값'이 같이 들어 있지 않은지 확인했다 —
# 이 파일은 API 가 통째로 주는 원본뿐이고 계산해 만든 값이 없다.
# 없으면 회사 리포트의 공고 칸만 빈다(서버는 뜬다).
backend/data/alio-jobs.json
backend/data/.alio-probe.json

# 고용24 채용공고 — 공개 화면을 하루 한 번 긁어 둔 것이라 같은 이유로 커밋하지 않는다.
# 계산해 만든 값이 없고(화면에서 읽은 필드 그대로), 없으면 공고 칸이 잡알리오로 물러난다.
backend/data/work24-jobs.json

# 회사 로고 캐시와 '회사명 → 홈페이지' 표. 둘 다 받아 두는 값이라 커밋하지 않는다.
# 로고는 회사 홈페이지에서 받은 이미지고(남의 저작물을 저장소에 넣지 않는다),
# 호스트 표는 DART 회사개황에서 다시 채워진다 — 없으면 로고만 이니셜로 물러난다.
backend/data/logos/
backend/data/company-logo-hosts.json

# 공모전·대외활동(위비티) — 하루 한 번 받는 스냅샷이라 커밋하지 않는다.
# 남의 사이트에서 받아 온 목록을 저장소에 넣어 두지 않는다는 뜻이기도 하다.
# 없으면 스펙업이 온통청년 결과만 보여준다(화면은 그대로 돈다).
backend/data/wevity.json

# 공모전 모집 포스터 — 원문 사이트에서 받아 둔 그림이다. 저장소에 넣지 않는다
# (남의 저작물을 커밋하지 않는다는 뜻이자, 캐시라서 언제든 다시 받을 수 있다).
backend/data/posters/

backend/data/users.json
backend/data/profiles.json

database/*.db
database/*.sqlite
database/*.sqlite3
backend/database/*.db
backend/database/*.sqlite
backend/database/*.sqlite3
# 직업 업무특성 캐시 — 고른 직업만 그때 받아 쌓는 값이라 깃에 넣지 않는다.
# 지워도 다음 조회 때 다시 받는다(backend/src/wage-traits.js).
backend/data/wage-traits/

# 사업보고서에서 뽑은 '무엇을 하는 회사인가' 줄글. 원문 ZIP 이 회사마다 5~14MB 라
# 열어 본 회사만 그때 뽑아 쌓는 값이다. 지워도 다음 조회 때 다시 만든다
# (backend/src/dart-report.js). 접수번호가 파일명이라 새 보고서가 나오면 새 파일이 된다.
backend/data/dart-report/

# 커리어 인사이트 글 5편을 복붙용으로 뽑아 둔 사본. 커밋하지 않는다 —
# 원본은 backend/src/insight-featured.js 하나뿐이고(스스로 '단일 출처' 라고 적어 뒀다),
# 심는 경로도 backend/scripts/seed-insights.js 로 이미 있다. 같은 글이 두 곳에 있으면
# 한쪽만 고쳐질 때 어느 게 맞는지 알 수 없다.
# 이 파일이 생긴 이유는 배포 서버에 시드가 아직 안 돌아서다 — 돌고 나면 필요 없어진다.
커리어인사이트-5편.md

# 합격 자소서 표본 원문. 남의 저작물이라 저장소에 넣지 않는다 — 로고·포스터·공고에
# 적어 둔 것과 같은 규칙이다. 대신 여기서 뽑은 **구조 지표만**
# backend/data/sample-corpus.json 으로 커밋한다(본문 없이 문장 수·문단 배분·숫자 밀도뿐).
#   다시 만들기: node backend/scripts/build-sample-corpus.js
#   폴더가 없으면 스크립트는 그냥 건너뛰고, 서버도 초안도 그대로 돈다.
자소서 코치 딥러닝 합격자소서/
