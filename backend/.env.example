# ── C:road 백엔드 환경변수 견본 ──
# 이 파일을 복사해 같은 폴더에 ".env" 로 만들고, 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 깃에 올라가지 않는다. 키를 여기(.env.example)에
# 넣지 말 것 — 이 파일은 커밋된다.

# 공공데이터포털(data.go.kr) 서비스키 (Decoding 키 권장)
# 발급: https://www.data.go.kr/data/15074404/openapi.do → 활용신청 후 마이페이지
# 계정당 하나이며, 활용신청이 승인된 API 라면 이 키 하나로 모두 호출된다.
#   쓰는 곳: scripts/fetch-ncs-taxonomy.js   (NCS 분류)
#           scripts/fetch-public-orgs.js    (공공기관 지정현황 → 공공기관 판별)
#           scripts/fetch-ftc-groups.js     (대규모기업집단 → 대기업 판별)
#           scripts/fetch-qnet-certs.js     (국가자격 종목 목록 → 자격증 선택 목록)
#             ↳ 이것만 호스트가 openapi.q-net.or.kr 이고 **HTTPS 를 지원하지 않는다**.
#               승인된 키로도 5회 중 1회쯤 resultCode 99 가 나므로 스크립트가 재시도한다.
#           src/specup.js                   (국가자격 시험일정 → 스펙 채우기의 '지금 접수 중')
#             ↳ **위 종목 목록과 다른 API 라 활용신청을 따로 해야 한다** (2026-08-16 승인 완료).
#               신청: https://www.data.go.kr/data/15074408/openapi.do
#               승인 전에는 같은 키로도 SERVICE_KEY_IS_NOT_REGISTERED 가 떨어진다.
#               numOfRows 상한이 50 이고, 넘기면 resultCode 930 이 HTTP 200 으로 온다.
#               확인: node scripts/check-specup-api.js
DATA_GO_KR_SERVICE_KEY=

# 온통청년(온라인청년센터) 오픈API 인증키 — data.go.kr 키와 별개다.
# 스펙 채우기(#specup)의 **공모전·대외활동 모집** 목록에 쓴다.
# 발급: 온통청년 회원가입·로그인 → 마이페이지 → OPEN API
#       https://www.youthcenter.go.kr/myPage/openapi
#       OPEN API 명은 **청년정책API** 를 고른다 (코드가 부르는 getPlcy 가 그것이다).
#       기본계획*·청년센터·청년콘텐츠 API 는 이 기능과 무관하다.
#   공모전·대외활동만 모아 주는 전국 단위 공개 API 는 없다(조사 결과는
#   docs/외부API-연동구조.md — 다시 조사하지 말 것). 그 대신 청년정책 목록에서
#   '공모전·서포터즈·기자단' 등을 키워드로 걸러 쓴다.
# 비워두면 그 두 탭만 "무엇을 하면 열리는지" 안내로 바뀌고, 나머지(선배 보유율 기준
# 부족 항목·자격증·어학)는 그대로 동작한다.
YOUTH_API_KEY=

# 공모전 카드에 **모집 포스터**를 띄울지 (기본: 꺼짐)
#   목록의 사실(제목·주최·마감)을 인용하는 것과, 주최사의 저작물인 포스터를 받아
#   우리 서버에서 다시 내보내는 것은 무게가 다르다. 위비티 이용약관 7조 2항도
#   '제3자의 저작권을 침해하지 않아야 한다' 고 적고 있어, **인용 허락을 문의해 두고
#   답이 오기 전까지는 꺼 둔다**(2026-09-07).
#   허락이 오면 여기에 on 만 적으면 된다. 꺼져 있으면 카드는 주관기관 로고 →
#   이모지로 물러나고, 나머지(공고 목록·마감·링크)는 그대로 나온다.
WEVITY_POSTER=

# 고용24(워크넷) 오픈API 인증키 — data.go.kr 키와 별개다.
# 고용24 는 자체 게이트웨이(openapi.work.go.kr)를 쓰고 인증키도 따로 발급한다.
# 발급: https://openapi.work.go.kr → 오픈API 신청 → 승인 후 발급된 인증키
#   쓰는 곳: scripts/fetch-worknet-jobs.js  (채용공고 → 직무 트렌드 = 역량 요구 빈도)
#           scripts/fetch-work24-companies.js (공채기업정보 → 중견기업 판별, 실측 2,102건)
#             ↳ 명세서 오타 주의: 회사명은 coNm 이고 coClcdNm 은 기업구분명이다.
#               명세서대로 읽으면 회사명 자리에 "중견기업" 이 들어간다(작업정리 3-3).
# 비워두면 자소서 코치의 '시장 비율' 배지와 중견기업 자동판정만 빠지고,
# 나머지 기능은 전부 정상 동작한다.
WORK24_API_KEY=

# 커리어넷 오픈API 인증키 — data.go.kr 키와 별개다.
# data.go.kr 등록이 'LINK' 형식이라 호출은 커리어넷(career.go.kr)으로 직접 간다.
# 발급: https://www.career.go.kr/cnet/front/openapi/openApiApply01Center.do
#   커리어넷 회원가입·로그인 → 오픈API 신청 → **담당자 수동 승인** 후 발급된다.
#   공공데이터포털처럼 즉시 발급이 아니다. 신청 현황:
#   https://www.career.go.kr/cnet/front/openapi/openApiApply04Center.do
#   키 하나로 커리어넷의 모든 오픈API 를 쓴다(학교정보용을 따로 받지 않는다).
#   쓰는 곳: scripts/fetch-universities.js   (대학 목록 → 스펙 입력의 '학교' 자동완성)
#   점검  : scripts/check-careernet-api.js  (파서를 고치기 전에 실제 응답 필드 확인)
# 비워두면 학교 자동완성만 안 뜨고 직접 입력은 그대로 된다.
CAREERNET_API_KEY=

# ── 본인확인 (NICE) ────────────────────────────────────────
# '한 사람 = 한 계정' 을 강제한다. 자세한 배경은 src/nice-auth.js 머리주석.
# 발급: NICE평가정보 계약 + 사이트 심사가 필요하다(무료 즉시 발급이 아니다).
#
# **키가 없으면 개발 모드로 동작한다** — 휴대폰 번호를 해시한 모의 CI 를 발급해
# 중복 차단·화면 흐름을 그대로 확인할 수 있다. 단 NODE_ENV=production 에서는
# 개발 모드가 막히므로(503), 운영에 올리기 전에 반드시 실제 키를 넣어야 한다.
# 세 개를 다 채워야 실제 연동으로 넘어간다.
NICE_SITE_CODE=
NICE_SITE_PASSWORD=
NICE_RETURN_URL=

# ── 백오피스 관리자 ────────────────────────────────────────
# 백오피스(회원 삭제·전체 초기화)에 들어갈 수 있는 아이디. 쉼표로 여러 개.
# 서버가 뜰 때 이 아이디들의 users.is_admin 을 켠다.
#
# **첫 관리자를 만드는 유일한 방법이다** — 관리자를 지정하는 화면도 백오피스 안에
# 있어서, 이게 비어 있으면 아무도 들어갈 수 없다.
# 가입하지 않은 아이디는 무시된다(가입 후 서버를 다시 띄우면 반영).
# 여기서 이름을 빼도 **권한이 해제되지는 않는다** — 설정 실수로 전원이 잠기지 않게.
# 권한 해제는 백오피스 화면에서 한다.
ADMIN_USERNAMES=

# ── 소셜 로그인 (네이버·카카오) ─────────────────────────────
# 키를 안 넣으면 버튼 자체가 화면에 안 뜬다. 일반 로그인은 그대로 동작한다.
#
# ⚠️ 위의 NAVER_CLIENT_ID 는 **뉴스 검색 API** 용이다. 로그인은 완전히 다른
#    애플리케이션이라 아래 값을 따로 받아야 한다. 같은 값을 넣으면 인증이 실패한다.
#
# 네이버: https://developers.naver.com/apps → 애플리케이션 등록
#   · 사용 API: '네이버 로그인'
#   · 서비스 URL: http://localhost:3000
#   · Callback URL: http://localhost:3000/api/auth/naver/callback
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
#
# 카카오: https://developers.kakao.com/console/app → 앱 만들기
#   · 카카오 로그인 활성화 ON
#   · Redirect URI: http://localhost:3000/api/auth/kakao/callback
#   · 동의항목에서 '닉네임'·'카카오계정(이메일)' 을 켜 둘 것 (안 켜면 이름이 비어 온다)
#   · KAKAO_REST_API_KEY 는 콘솔의 'REST API 키' (JavaScript 키가 아니다)
#   · KAKAO_CLIENT_SECRET 은 문서상 '조건부 필수' 지만, 요즘 새로 만든 REST API 키는
#     클라이언트 시크릿이 **켜진 채로 생성**된다. 즉 사실상 필수다.
#     앱 > 플랫폼 키 > REST API 키 > 클라이언트 시크릿 에서 확인.
#     빠뜨리면 토큰 발급에서 실패하는데 메시지가 불친절해 원인을 찾기 어렵다.
#   · OpenID Connect 는 켤 필요 없다 — careerly 는 일반 OAuth 2.0 으로 붙였고
#     id_token 을 쓰지 않는다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 배포하면 콜백 주소가 바뀐다. 각 콘솔에도 배포 주소를 **추가로** 등록해야 한다.
# 이 값을 비워두면 요청이 들어온 호스트를 그대로 쓴다(개발 중에는 그게 편하다).
# OAUTH_REDIRECT_BASE=https://your-deployed-domain.com

# 배포 시에만 필요 (개발 중에는 비워둬도 됨)
# NODE_ENV=production
# ALLOWED_ORIGINS=https://your-deployed-domain.com
#
# 배포 환경은 둘이다 — production(main 브랜치)과 staging(dev 브랜치).
# 두 값은 **각 환경의 도메인**으로 서로 다르게 넣는다. 자세한 건 docs/배포.md 8장.
# 이 파일(.env)은 로컬 전용이므로 여기서는 둘 다 비워 둔다.

# ── AI (Groq 전용) ────────────────────────────────────────────
# 쓰는 곳: 스펙 "AI로 한 번에 입력"(POST /api/cas/analyze)
#          자소서 코치 역량 보강(POST /api/jd/coach)
#          자소서 AI 초안(POST /api/jd/draft)
#
# 키 발급 무료(신용카드 불필요): https://console.groq.com/keys
# 없으면 위 세 기능만 503 을 돌려주고 나머지 화면은 그대로 동작한다.
#
# 예전에는 로컬 Ollama 를 기본으로 두고 Groq 를 선택지로 뒀는데, 환경변수가 안 읽히면
# 조용히 Ollama 로 떨어져서 "로컬 Ollama 에 연결할 수 없습니다" 라는 쓰지도 않는 도구의
# 오류가 사용자 화면에 떴다. 프로바이더를 하나로 줄여 그 실패 모드를 없앴다.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b       # 폐기 공지가 뜨면 여기만 바꾼다 (코드 기본값과 같다)
#   현행 모델 목록: https://console.groq.com/docs/models
# CAS_AI_TIMEOUT_MS=60000               # Groq·Gemini 공통 타임아웃
#
# 설정 확인: node scripts/check-ai.js

# ── AI 초안만 Gemini (선택) ───────────────────────────────────
# 자소서 AI 초안(POST /api/jd/draft·/motive)만 한국어 문장이 더 자연스러운 Gemini 로
# 보낸다(사용자 선택 2026-08-28). 스펙 분류·역량 추출은 그대로 Groq(속도·일한도 우위).
#
# **이 키가 있으면** 초안은 Gemini 로, **없으면** 초안도 Groq 로 되돌아간다(명시적 라우팅 —
# ai-gemini.js 머리주석). 응답의 provider·model 필드에 무엇으로 썼는지 실린다.
#
# 키 발급 무료(신용카드 불필요): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash        # 폐기되면 여기만 바꾼다 (목록: https://ai.google.dev/gemini-api/docs/models)

# 회사 뉴스 (자소서 '지원동기' 소재 · GET /api/news/company)
# 비워두면 키 없이 동작하는 웹 검색으로 대신한다(정확도가 낮고 날짜가 없다).
# 발급처가 둘인데 **어느 쪽이든 된다**. 응답 형식이 같아 서버가 자동으로 가려 쓴다.
#   · NCP 콘솔 → NAVER API Hub → 검색   (Client ID/Secret. Secret 40자)
#   · https://developers.naver.com → 애플리케이션 등록 → 사용 API 에 '검색' (Secret 10자 안팎)
# 주의: 두 콘솔 값을 하나씩 섞어 넣으면 양쪽 다 인증 실패한다.
# 확인: node scripts/check-news-api.js
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NEWS_PROVIDER=ncp       # ncp | naver | web (기본: 키가 있으면 자동 판별)

# ── 기업분석 재무·경쟁사 (DART 전자공시) ────────────────────
# 없으면 기업분석의 '재무·경쟁사' 칸만 비고 나머지(뉴스·역량)는 그대로 동작한다.
#
# 발급: https://opendart.fss.or.kr → 인증키 신청 (무료·즉시, 일 20,000건)
# 발급 후 한 번만:
#   node scripts/fetch-dart-corps.js       # 고유번호 색인 (상장사 2,700여 건)
#   node scripts/build-dart-industry.js    # 업종코드 채우기 — 경쟁사 비교에 필요
DART_API_KEY=
# 색인 받기는 배포 빌드에서도 돈다(루트 package.json 의 build). 빌더 경로가 느린 날
# 60초에 끊겨 색인 없이 배포된 적이 있어 재시도를 넣었다 — 그 값들이다.
# DART_FETCH_TIMEOUT_MS=120000   # 한 번당 제한 (로컬 실측 2.6~4.3초)
# DART_FETCH_ATTEMPTS=3          # 실패하면 5초·10초 쉬고 다시

# ── 공고 주소로 본문 가져오기 ────────────────────────────────
# 자소서 코치의 '가져오기' 버튼. 키가 필요 없다 — 사용자가 준 주소를 서버가 한 번
# 열어 본문만 뽑는다. 내부망 차단(SSRF)은 코드가 하고, 아래는 상한값일 뿐이다.
# POSTING_FETCH_TIMEOUT_MS=12000
# POSTING_FETCH_MAX_BYTES=3145728
# 연결 자체가 안 되는 사이트(데이터센터 IP 차단)를 기억해 두는 시간. 그동안은
# 10초를 다시 기다리지 않고 즉시 안내로 넘긴다. 성공하면 바로 잊는다.
# POSTING_UNREACHABLE_TTL_MS=600000
# 이미지로 된 공고를 Gemini 비전으로 읽는다(26-8 → 2026-09-07). 키는 위 GEMINI_API_KEY
# 를 그대로 쓰고, 없으면 이 기능만 조용히 꺼진다(공고 가져오기 자체는 그대로 된다).
# 글이 안 나온 공고에서만 부른다 — 본문이 멀쩡하면 이미지를 아예 열지 않는다.
# POSTING_OCR_MAX_IMAGES=2             # 한 번에 읽을 이미지 장수 (많을수록 느려진다)
# POSTING_OCR_TIMEOUT_MS=120000        # 실측 편차가 9.7~76.5초라 넉넉히 잡았다
# 사용자가 **직접 올린** 이미지(POST /api/jd/posting-image)도 같은 설정을 쓴다.
# 그 경로만 본문 한도가 12MB 다 — 화면이 줄여 보내지만 못 줄이는 형식(HEIC)이 있다.
# 사용자가 직접 올린 이미지(POST /api/jd/posting-image)도 같은 설정을 쓴다. 그 경로만
# 본문 한도가 12MB 다 — 화면이 줄여 보내지만 줄이지 못하는 형식(HEIC)이 있어서다.

# ── 회사별 채용공고 (사람인 오픈API) ──────────────────────────
# 회사 리포트의 '채용공고' 칸에 그 회사의 실제 공고를 띄운다.
# 신청: https://oapi.saramin.co.kr/join → 승인 후 로그인하면 access-key 발급 (하루 500회)
#
# 워크넷(WORK24_API_KEY)도 같은 일을 하지만 **개인회원 키로는 목록 API 가 막힌다**
# ("개인회원은 사용할 수 없는 OPEN-API입니다"). 기업/기관 회원으로 전환하면 보조로 쓰인다.
# 둘 다 없으면 공고 목록만 빠지고 나머지(개요·재무·기사·경쟁사)는 그대로 나온다.
SARAMIN_ACCESS_KEY=

# 공공기관 채용공고(잡알리오) 목록 조회 요청주소.
# 공공데이터포털 '재정경제부_공공기관 채용정보 조회서비스'(15125273) 를 활용신청(자동승인)한 뒤
# 마이페이지 > 오픈API > 개발계정 > 상세기능정보 에 적힌 목록 조회 요청주소를 넣는다.
#
# ⚠ 포털에서 복사하기 쉬운 것은 요청주소가 아니라 **Swagger 예제 URL** 이다.
#   거기에는 예제 필터가 붙어 있어(recrutPbancTtl=보훈 · pbancBgngYmd=2023-07-01 …)
#   그대로 넣으면 HTTP 200 · resultCode 200 인데 결과만 0건이 나온다 — 실제로 겪었다.
#   수집기가 쿼리스트링을 떼어내고 무엇을 뗐는지 알려주지만, 주소만 넣는 편이 낫다.
# 인증키는 DATA_GO_KR_SERVICE_KEY 를 그대로 쓴다(따로 발급받지 않는다).
# 비워두면 수집 스크립트만 안 돌고 서버는 정상 동작한다 — 공고 칸만 빈다.
#   node scripts/fetch-alio-jobs.js --probe   # 응답을 먼저 눈으로 확인
#   node scripts/fetch-alio-jobs.js           # 전량 수집
ALIO_API_URL=

# ── 결제 (토스페이먼츠) ─────────────────────────────────────
# 키를 안 넣으면 결제 없이 신청만 남는다(개발 중에 결제 흐름이 막히지 않게).
#
# 발급: https://developers.tosspayments.com → 회원가입만 하면 '개발자용 테스트상점'
#       키가 바로 나온다. 사업자등록증이 없어도 된다.
#       테스트 키로는 실제 카드번호를 넣어도 가상 승인이라 돈이 나가지 않는다.
#
#   TOSS_CLIENT_KEY : test_ck_... — 브라우저 SDK 가 결제창을 띄울 때 쓴다(공개돼도 된다)
#   TOSS_SECRET_KEY : test_sk_... — **서버 전용.** 승인 API 호출에 쓴다.
#                     절대 프론트로 내려보내지 말 것 — 누구나 우리 상점으로
#                     결제·취소를 부를 수 있게 된다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── MySQL ───────────────────────────────────────────────────
# 저장소가 JSON 파일에서 MySQL 로 바뀌었다. 연결이 안 되면 서버가 아예 뜨지 않는다
# (DB 없이 뜬 서버는 모든 API 가 500 을 내며 살아있는 척해서 원인을 찾기 어렵다).
#
# 로컬 개발 — Docker 로 띄우는 것이 가장 간단하다:
#   docker run -d --name careerly-mysql -e MYSQL_ROOT_PASSWORD=careerly_dev \
#     -e MYSQL_DATABASE=careerly -p 3306:3306 mysql:8.0 \
#     --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
#   node scripts/load-schema.js                  # 테이블 13개 (mysql CLI 없이 동작)
#   node scripts/migrate-to-mysql.js --catalog   # 자격증·학과·기업·직업 카탈로그
# 전체 셋업 절차는 docs/팀-개발환경.md 에 있다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=careerly
#
# 배포(Railway) — MySQL 서비스를 추가하면 MYSQL_URL 을 주입해 준다.
# 이 값이 있으면 위의 DB_* 는 무시된다.
# MYSQL_URL=mysql://user:pass@host:3306/railway
